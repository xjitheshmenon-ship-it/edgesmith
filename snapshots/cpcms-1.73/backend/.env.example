# Copy to .env on the server and edit before first start.
PORT=3001
JWT_SECRET=put-a-long-random-string-here
TOKEN_DAYS=7
# First-run admin (used only when the users table is empty)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@edgesmith.in
ADMIN_PASSWORD=change-this-password

# Email (optional — enables invitation + reset links). Create a mailbox like
# noreply@edgesmith.in in Hostinger hPanel → Emails, then fill these in:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@edgesmith.in
SMTP_PASS=the-mailbox-password
MAIL_FROM=Edgesmith CPCMS <noreply@edgesmith.in>
APP_URL=https://cpcms.edgesmith.in
